<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Permisos de la copia de DESARROLLO (la que se instala por cable desde Xcode).

  `aps-environment` es lo que decide a qué APNs pertenece el token que entrega
  iOS: en desarrollo, al de pruebas. Un token de pruebas no vale en producción y
  al revés —Apple responde 400 BadDeviceToken—, y por eso el servidor tiene su
  propio interruptor (`APNS_ENV`).
-->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>

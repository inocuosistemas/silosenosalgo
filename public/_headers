# Cabeceras para Cloudflare Pages. CF Pages IGNORA netlify.toml, asi que las
# reglas de cache/seguridad deben vivir aqui (Vite copia public/ -> dist/).
# Mantener en sync con netlify.toml por si tambien se despliega en Netlify.

# Cloudflare Pages ya versiona e invalida los assets de cada deployment. No
# sobrescribir su cache aqui: con el fallback SPA, una peticion a un hash antiguo
# podia recibir index.html y quedar cacheada un ano bajo una URL .js/.css.

# index.html debe revalidarse siempre para que los usuarios vean cada deploy.
/index.html
  Cache-Control: no-cache, must-revalidate

# Manifiesto OTA que consulta la app iOS para saber si hay visor nuevo. Si se
# cacheara, la app seguiria viendo el build anterior indefinidamente.
/ota-manifest.json
  Cache-Control: no-cache, must-revalidate

# Cabeceras de seguridad base para todo el sitio.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

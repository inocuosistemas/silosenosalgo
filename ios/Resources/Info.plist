<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>SiLoSeNoSalgo - Baliza</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- La app solo cifra con HTTPS estándar, que está exento. Declararlo aquí
	     evita que App Store Connect pregunte por el cumplimiento de exportación
	     en cada subida a TestFlight. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Al declarar CFBundleDocumentTypes, Apple exige decir también cómo se
	     abre el fichero, y avisa en cada subida si falta. «En su sitio» es lo
	     que recomienda y lo que encaja aquí: importGuide lee el original con
	     permiso de ámbito y se queda una copia propia en LocalStore, así que no
	     hace falta que el sistema duplique nada en Documents/Inbox, que además
	     nadie limpia después. No expone la carpeta de la app en Archivos: eso
	     pide además UIFileSharingEnabled, que no está puesto. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Guía offline SiLoSeNoSalgo</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.themakercrowd.slsnsguide</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Guía offline SiLoSeNoSalgo</string>
			<key>UTTypeIdentifier</key>
			<string>com.themakercrowd.slsnsguide</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>slsnsguide</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SiLoSeNoSalgo usa tu ubicación para compartir tu posición en directo durante la carrera.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Para seguir compartiendo tu posición con la pantalla apagada o la app en segundo plano, permite el acceso a la ubicación "Siempre".</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>SiLoSeNoSalgo usa el micrófono para grabar notas de voz ancladas a tu posición.</string>
	<key>NSCameraUsageDescription</key>
	<string>SiLoSeNoSalgo usa la cámara para hacer una foto y anclarla a una nota de campo.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>SiLoSeNoSalgo guarda en tu carrete la foto original a máxima calidad; en la app queda una copia ligera.</string>
</dict>
</plist>

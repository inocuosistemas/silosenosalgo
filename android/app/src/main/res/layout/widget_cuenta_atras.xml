<?xml version="1.0" encoding="utf-8"?>
<!-- La cuenta atrás en la pantalla de inicio: la foto (o el color) de fondo, y
     encima el nombre, los días y el reloj, que cuenta solo (ver WidgetCuentaAtras). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/fondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom|start"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:shadowColor="#99000000"
            android:shadowRadius="4" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="44sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:shadowColor="#99000000"
                android:shadowRadius="6" />

            <TextView
                android:id="@+id/unidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp"
                android:shadowColor="#99000000"
                android:shadowRadius="4" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/reloj"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:shadowColor="#99000000"
            android:shadowRadius="4" />
    </LinearLayout>
</FrameLayout>

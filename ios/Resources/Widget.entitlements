<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Permisos del WIDGET. Solo necesita una cosa: el grupo compartido donde la app
  le deja los contadores. Sin él, el widget no puede leer nada (es otro
  proceso, con su propia caja).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.themakercrowd.silosenosalgo</string>
	</array>
</dict>
</plist>

# Plantilla. El fichero de verdad se llama `keystore.properties`, está
# git-ignored y lo genera solo `scripts/crear-keystore.ps1` (o el .sh).
#
# NUNCA subas al repositorio ni este fichero relleno ni el .jks: quien tenga las
# dos cosas puede publicar actualizaciones firmadas como si fuera vosotros.
#
# En integración continua no se usa este fichero: las mismas cuatro cosas se
# leen de las variables SLSNS_STORE_FILE, SLSNS_STORE_PASSWORD, SLSNS_KEY_ALIAS
# y SLSNS_KEY_PASSWORD.

# Ruta del almacén, relativa a `android/`.
storeFile=silosenosalgo-release.jks
storePassword=
keyAlias=silosenosalgo
keyPassword=
